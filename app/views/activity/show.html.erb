<div class="activity-wrap">
  <div class="chat-pane">
    <div class="chat-hd" style="flex-wrap:wrap;row-gap:6px">
      <span class="dot" style="background:var(--accent)"></span>
      <span class="chat-title"><%= @room == ActivityController::WORKSPACE_ROOM ? "Workspace" : @room %> · Architect</span>
      <span class="mono-dim">
        real agent session — context carries across messages
      </span>
      <span class="spacer"></span>
      <% if @rooms.size > 1 %>
        <div class="chip-row">
          <% @rooms.each do |room| %>
            <%= link_to room == ActivityController::WORKSPACE_ROOM ? "workspace" : room,
                        activity_path(room: room),
                        class: "chip#{' on' if room == @room}",
                        style: "padding:2px 8px;font-size:10.5px;text-decoration:none" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="chat-log">
      <% if @messages.empty? && !@awaiting_reply %>
        <span class="mono-meta">
          no messages yet — ask the Architect about <%= @room == ActivityController::WORKSPACE_ROOM ? "the workspace" : @room %>
        </span>
      <% end %>
      <% @messages.each do |message| %>
        <div class="msg <%= message.from_user? ? 'mine' : 'theirs' %>">
          <div class="msg-hd">
            <span class="msg-who" style="color:<%= message.from_user? ? 'var(--tx2)' : 'var(--accent)' %>"><%= message.sender.upcase %></span>
            <span class="msg-time"><%= message.sent_at.strftime("%H:%M") %></span>
          </div>
          <div class="msg-body"><%= message.body %></div>
          <% if message.attach_label.present? %>
            <div class="msg-attach">▤ <%= message.attach_label %></div>
          <% end %>
        </div>
      <% end %>
      <% if @awaiting_reply %>
        <div class="msg theirs" data-controller="live-refresh">
          <div class="msg-hd">
            <span class="msg-who" style="color:var(--accent)">ARCHITECT</span>
          </div>
          <div class="msg-body"><span class="cursor">▌</span> reading the workspace and thinking…</div>
        </div>
      <% end %>
    </div>

    <%= form_with url: chat_messages_path(room: @room), method: :post, class: "chat-composer",
                  data: { controller: "composer", action: "turbo:submit-end->composer#clear" } do %>
      <textarea name="body" id="chat-body" data-turbo-permanent data-composer-target="input"
                data-action="keydown->composer#submitOnEnter"
                class="textarea" placeholder="Steer the agent — constraints, corrections, context…"></textarea>
      <button type="submit" class="btn-accent" style="padding:9px 15px;font-size:12.5px">Send</button>
    <% end %>
  </div>

  <div class="events-side">
    <div class="events-side-hd"><%= @room == ActivityController::WORKSPACE_ROOM ? "Event stream" : "#{@room} events" %></div>
    <% if @events.empty? %>
      <div class="side-event"><span class="mono-meta">no events yet</span></div>
    <% end %>
    <% @events.each do |event| %>
      <div class="side-event">
        <div class="side-event-hd">
          <span class="mono-meta" style="font-size:10px"><%= event_time(event) %></span>
          <span class="stream-phase" style="font-size:10px;color:<%= event.tone %>"><%= event.phase_tag %></span>
        </div>
        <div class="side-event-text"><%= event.text %></div>
      </div>
    <% end %>
  </div>
</div>
