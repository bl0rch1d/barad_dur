<div class="screen-bar">
  <span class="screen-title">Board</span>
  <span class="mono-dim"><%= @board_count %> tickets · <%= @running_count %> running</span>
  <span class="spacer"></span>
  <% if @shipped_count.positive? || @shipped_view %>
    <%= link_to @shipped_view ? "⏶ back to board" : "⏷ shipped #{@shipped_count}",
                board_path(@shipped_view ? {} : { shipped: 1 }),
                class: "btn-ghost btn-sm hv-soft" %>
  <% end %>
  <%= link_to "✦ Feature request", rfc_path, class: "btn-ghost btn-sm hv-acc" %>
</div>

<% if @shipped_view %>
  <div class="screen" style="padding-top:12px">
    <div class="panel" style="max-width:860px">
      <div class="panel-hd"><span class="k-label">Shipped</span><span class="spacer"></span><span class="mono-meta"><%= @shipped_count %> tickets</span></div>
      <% if @shipped.empty? %>
        <div class="commit-row"><span class="mono-meta">nothing shipped yet</span></div>
      <% end %>
      <% @shipped.each do |ticket| %>
        <div class="commit-row">
          <%= link_to ticket.code, url_for(ticket: ticket.code), class: "commit-sha" %>
          <span class="commit-msg"><%= ticket.title %></span>
          <span class="mono-meta"><%= ticket.repo %></span>
          <% if ticket.cost.to_f.positive? %><span class="mono-meta">$<%= format("%.2f", ticket.cost) %></span><% end %>
          <span class="mono-meta"><%= ticket.finished_at ? ago_label(ticket.finished_at) : "—" %></span>
        </div>
      <% end %>
    </div>
  </div>
<% else %>

<% show_filters = @repo_options.size > 1 || @blocked_only || @repo_filter %>
<div class="screen-bar" style="padding-top:0<%= ";border-bottom:0" if show_filters %>">
  <%= form_with url: tickets_path, method: :post, class: "ticket-composer" do %>
    <div class="tc-row">
      <input name="title" placeholder="Draft a ticket — one line of intent…" autocomplete="off"
             class="textarea tc-title">
      <select name="repo" class="textarea tc-repo">
        <% repos = Workspace.selected_ticket_targets.presence ||
                   Ticket.on_board.distinct.pluck(:repo).compact.uniq.sort %>
        <% repos.each do |repo| %><option value="<%= repo %>"><%= repo %></option><% end %>
      </select>
      <label class="tc-risky"><input type="checkbox" name="risky" value="1">risky</label>
      <button type="submit" class="btn-ghost btn-sm hv-acc busy-btn" data-turbo-submits-with="Filing…">+ File draft</button>
    </div>
    <textarea name="description" rows="1" class="textarea tc-desc"
              placeholder="Optional free-form description — any format, as much detail as you like…"></textarea>
  <% end %>
</div>

<% if show_filters %>
  <div class="screen-bar" style="padding-top:0;padding-bottom:10px">
    <span class="k-label">Filter</span>
    <div class="chip-row">
      <%= link_to "all", board_path(blocked: @blocked_only ? "1" : nil),
                  class: "chip#{' on' if @repo_filter.nil?}", style: "text-decoration:none" %>
      <% @repo_options.each do |repo| %>
        <%= link_to repo, board_path(repo: repo, blocked: @blocked_only ? "1" : nil),
                    class: "chip#{' on' if @repo_filter == repo}", style: "text-decoration:none" %>
      <% end %>
      <span class="vdiv" style="height:18px;align-self:center"></span>
      <%= link_to board_path(repo: @repo_filter, blocked: @blocked_only ? nil : "1"),
                  class: "chip#{' on' if @blocked_only}",
                  style: "text-decoration:none;display:inline-flex;align-items:center;gap:6px" do %>
        <span class="dot" style="background:var(--err)"></span>blocked only
      <% end %>
    </div>
  </div>
<% end %>

<div class="board-wrap">
  <% @columns.each do |column| %>
    <div class="board-col">
      <div class="col-hd">
        <span class="dot" style="background:<%= column[:tone] %>"></span>
        <span class="col-name"><%= column[:name] %></span>
        <span class="col-count"><%= column[:tickets].size %></span>
      </div>

      <% column[:tickets].each do |ticket| %>
        <% blocker = column[:blocked] ? ticket.blocker : nil %>
        <div class="card hv-bd" style="border-left:2px solid <%= column[:tone] %>">
          <div class="card-hd">
            <span class="card-id"><%= ticket.code %></span>
            <% if ticket.risky? %><span class="risk-tag">RISK</span><% end %>
            <% if blocker %>
              <span class="risk-tag" style="color:var(--warn);border-color:var(--warn)"><%= blocker[:type].upcase %></span>
            <% end %>
            <div class="spacer"></div>
            <span class="card-est"><%= ticket.est_label %></span>
          </div>
          <%= link_to url_for(ticket: ticket.code), class: "card-title", style: "color:var(--tx)" do %>
            <%= ticket.title %>
          <% end %>
          <% if blocker %>
            <div class="mono-meta" style="color:var(--warn);overflow-wrap:anywhere"><%= blocker[:label] %></div>
            <% if blocker[:type] == "gate" && (gate = ticket.ticket_gates.detect { |g| g.status == "pending" }) %>
              <%= button_to "✓ Approve", approve_gate_path(gate), form_class: "bt",
                            class: "btn-outline-warn busy-btn", style: "padding:3px 10px;font-size:11px",
                            data: { turbo_submits_with: "Approving…" } %>
            <% elsif blocker[:type] == "clarification" %>
              <div class="mono-meta">open the ticket to answer</div>
            <% end %>
          <% end %>
          <div class="pips">
            <% ticket_pips(ticket).each do |colour, mark| %><span class="<%= mark %>" style="background:<%= colour %>"></span><% end %>
          </div>
          <div class="card-foot">
            <span class="card-agent"><%= blocker ? state_meta(ticket.state)[:name].downcase : ticket.agent_label %></span>
            <% if ticket.draft? %>
              <%= button_to "→ groom", ticket_groom_path(ticket.code), form_class: "bt",
                            class: "card-btn hv-acc", style: "border-color:var(--accent);color:var(--accent)",
                            data: { turbo_submits_with: "queuing…" } %>
            <% else %>
              <% button = card_button(ticket) %>
              <%= link_to button[:label], url_for(ticket: ticket.code), class: "card-btn",
                          style: "border-color:#{button[:tone]};color:#{button[:fg]};text-decoration:none" %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if column[:state] == "draft" %>
        <span class="add-btn" style="cursor:default">↑ file drafts above</span>
      <% elsif column[:state] == "ready_to_implement" %>
        <%= link_to "+ via feature request", rfc_path, class: "add-btn hv-soft" %>
      <% end %>
    </div>
  <% end %>
</div>
<% end %>
