<div class="screen-bar">
  <span class="screen-title">Board</span>
  <span class="mono-dim"><%= @board_count %> tickets · <%= @running_count %> running</span>
  <span class="spacer"></span>
  <%= link_to "✦ Feature request", rfc_path, class: "btn-ghost btn-sm hv-acc" %>
</div>

<div class="screen-bar" style="border-top:0;padding-top:0">
  <%= form_with url: tickets_path, method: :post, style: "display:flex;gap:8px;align-items:center;flex:1" do %>
    <input name="title" placeholder="File a ticket — one line of intent…" autocomplete="off"
           class="textarea" style="flex:1;min-height:0;padding:6px 10px;font-size:12px">
    <select name="repo" class="textarea" style="min-height:0;padding:6px;font-size:12px;width:150px">
      <% repos = (Workspace.ticket_targets + Ticket.on_board.distinct.pluck(:repo)).compact.uniq %>
      <% repos.each do |repo| %><option value="<%= repo %>"><%= repo %></option><% end %>
    </select>
    <label style="display:flex;gap:5px;align-items:center;font-size:11px;color:var(--tx2)">
      <input type="checkbox" name="risky" value="1">risky
    </label>
    <button type="submit" class="btn-ghost btn-sm hv-acc">+ File ticket</button>
  <% end %>
</div>

<div class="board-wrap">
  <% @columns.each do |column| %>
    <div class="board-col">
      <div class="col-hd">
        <span class="dot" style="background:<%= column[:tone] %>"></span>
        <span class="col-name"><%= column[:name] %></span>
        <span class="col-count"><%= column[:tickets].size %></span>
      </div>

      <% column[:tickets].each do |ticket| %>
        <%= link_to url_for(ticket: ticket.code), class: "card hv-bd",
                    style: "border-left:2px solid #{column[:tone]}" do %>
          <div class="card-hd">
            <span class="card-id"><%= ticket.code %></span>
            <% if ticket.risky? %><span class="risk-tag">RISK</span><% end %>
            <span class="spacer"></span>
            <span class="card-est"><%= ticket.est_label %></span>
          </div>
          <div class="card-title"><%= ticket.title %></div>
          <div class="pips">
            <% ticket_pips(ticket).each do |pip| %><span style="background:<%= pip %>"></span><% end %>
          </div>
          <div class="card-foot">
            <span class="card-agent"><%= ticket.agent_label %></span>
            <% button = card_button(ticket) %>
            <span class="card-btn" style="border-color:<%= button[:tone] %>;color:<%= button[:fg] %>"><%= button[:label] %></span>
          </div>
        <% end %>
      <% end %>

      <%= link_to "+ add", rfc_path, class: "add-btn hv-soft" %>
    </div>
  <% end %>
</div>
