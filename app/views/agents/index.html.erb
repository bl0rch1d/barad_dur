<div class="screen">
  <div class="title-row">
    <span class="page-title">The Legion</span>
    <span class="mono-dim">
      <%= @harness ? "roster mapped from #{@harness.repo}/.claude/agents" : "spec-first harness" %>
      · <%= @agents.size %> roles · $<%= format("%.2f", @total_cost) %> today
    </span>
  </div>

  <div class="agents-grid">
    <% @agents.each do |agent| %>
      <%= link_to url_for(agent: agent.id), class: "agent-card hv-bd", style: "text-decoration:none;color:inherit" do %>
        <div class="agent-hd">
          <span class="agent-abbr" style="background:<%= agent.soft %>;color:<%= agent.tone %>"><%= agent.abbr %></span>
          <div class="agent-id">
            <span class="agent-name"><%= agent.name %></span>
            <span class="agent-role"><%= agent.role %></span>
          </div>
          <span class="tag" style="color:<%= agent.tone %>"><%= agent.status %></span>
        </div>
        <div class="agent-doing"><%= agent.doing %></div>
        <div class="tool-chips">
          <% agent.tools.each do |tool| %><span class="tool-chip"><%= tool %></span><% end %>
        </div>
        <div class="agent-stats">
          <% [["model", agent.llm_model],
              ["today", "$#{format('%.2f', agent.cost_today)}"],
              ["tickets", agent.tickets.count]].each do |key, value| %>
            <div class="agent-stat">
              <span class="k"><%= key %></span>
              <span class="v"><%= value %></span>
            </div>
          <% end %>
        </div>
        <span class="mono-meta" style="color:var(--tx3)">click to configure ›</span>
      <% end %>
    <% end %>
  </div>

  <% if @specialists.any? %>
    <div class="title-row" style="padding-top:6px">
      <span class="k-label">Delegation specialists — spawned inside runs via the Task tool, never assigned tickets</span>
    </div>
    <div class="agents-grid">
      <% @specialists.each do |specialist| %>
        <div class="agent-card" style="opacity:.85">
          <div class="agent-hd">
            <span class="agent-abbr" style="background:var(--info-soft);color:var(--info)"><%= specialist[:name].split(/[-_]/).first(2).map { |p| p[0] }.join.upcase %></span>
            <div class="agent-id">
              <span class="agent-name"><%= specialist[:name] %></span>
              <span class="agent-role"><%= @harness.repo %> · .claude/agents</span>
            </div>
            <span class="tag" style="color:var(--info)">delegate</span>
          </div>
          <div class="agent-doing"><%= specialist[:description].presence || "no description" %></div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
