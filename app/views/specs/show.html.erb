<div class="specs-wrap">
  <div class="specs-pane">
    <div class="specs-pane-hd" style="display:flex;align-items:center;gap:6px">
      <span style="flex:1">openspec · <%= @specs.size %> capabilities</span>
      <% sync_progress = @setting.setup["spec_sync_progress"] %>
      <% sync_progress = nil if sync_progress && sync_progress["at"].to_i < 90.seconds.ago.to_i %>
      <% if sync_progress %>
        <span class="mono-meta" style="color:var(--accent)">parsing <%= sync_progress["done"] %>/<%= sync_progress["total"] %>…</span>
      <% elsif Workspace.available? %>
        <%= button_to "⟳ rescan", specs_sync_path,
                      form: { id: "specs-rescan-form", data: { turbo_permanent: true } },
                      form_class: "bt", class: "chip hv-acc busy-btn",
                      title: "Re-parse openspec specs from the workspace",
                      style: "padding:1px 7px;font-size:10px",
                      data: { turbo_submits_with: "parsing…" } %>
      <% end %>
    </div>
    <% @specs.each do |spec| %>
      <%= link_to "#{specs_path}/#{spec.slug}", class: "spec-item#{' on' if spec.id == @spec&.id}" do %>
        <span class="spec-path"><%= spec.slug %></span>
        <span class="mono-meta"><%= spec.meta_label %></span>
      <% end %>
    <% end %>
  </div>

  <div class="spec-doc">
    <% if @spec %>
      <div class="spec-doc-inner">
        <div class="spec-head">
          <span class="mono-meta"><%= @spec.file %></span>
          <span class="spec-title"><%= @spec.title %></span>
          <span class="spec-purpose"><%= @spec.purpose %></span>
          <div class="spec-tags">
            <% @spec.tags.each do |tag| %><span class="spec-tag"><%= tag %></span><% end %>
          </div>
        </div>

        <% @spec.spec_requirements.each do |req| %>
          <div class="panel">
            <div class="req-hd">
              <span class="req-id"><%= req.rid %></span>
              <span class="req-name"><%= req.name %></span>
              <span class="tag" style="color:<%= req.tone %>"><%= req.status %></span>
            </div>
            <div class="req-body">
              <div class="req-text"><%= req.body %></div>
              <% req.spec_scenarios.each do |scenario| %>
                <div class="scenario">
                  <span class="scenario-name"><%= scenario.name %></span>
                  <span class="scenario-body"><%= scenario.body %></span>
                </div>
              <% end %>
              <div class="req-foot">
                <span><%= req.impl_ref %></span><span><%= req.tests_label %></span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
