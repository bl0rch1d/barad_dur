<% agent = @panel_agent %>
<% phase_on = Features.phase?(agent.role) %>
<% invocation = Harness.phase_invocation(agent.role, @setting) %>
<% delegates = Harness.phase_agents(agent.role, @setting) %>
<div class="overlay">
  <%= link_to "", request.path, class: "overlay-dismiss" %>
  <div class="drawer">
    <div class="drawer-hd">
      <div class="drawer-hd-row">
        <span class="agent-abbr" style="background:<%= agent.soft %>;color:<%= agent.tone %>"><%= agent.abbr %></span>
        <span class="drawer-id"><%= agent.role %></span>
        <span class="tag" style="color:<%= agent.tone %>"><%= agent.status %></span>
        <span class="spacer"></span>
        <%= link_to "✕", request.path, class: "close-btn" %>
      </div>
      <div class="drawer-title"><%= agent.name %></div>
      <div class="mono-meta" style="line-height:1.6;color:var(--tx2)"><%= agent.blurb %></div>
    </div>

    <div class="drawer-body">
      <!-- ── model ────────────────────────────────────────── -->
      <div class="panel">
        <div class="panel-hd">
          <span class="k-label">Model</span>
          <span class="spacer"></span>
          <span class="mono-meta">
            <%= agent.pinned? ? "pinned to this agent" : "following the realm setting" %>
          </span>
        </div>
        <div style="padding:12px 14px;display:flex;flex-direction:column;gap:8px">
          <div class="chip-row">
            <%= button_to agent_model_path(agent, model: ""), form_class: "bt",
                          class: "chip#{' on' unless agent.pinned?}" do %>
              follow realm · <%= Setting::ORCHESTRATOR_MODELS[@setting.orchestrator_model] %>
            <% end %>
            <% Setting::ORCHESTRATOR_MODELS.each do |value, label| %>
              <%= button_to label, agent_model_path(agent, model: value), form_class: "bt",
                            class: "chip#{' on' if agent.model_id == value}" %>
            <% end %>
          </div>
          <span class="mono-meta" style="line-height:1.55">
            Runs on <span class="mono" style="color:var(--accent)"><%= agent.model_label %></span>.
            A cheaper model on a mechanical phase costs less; a stronger one on planning or
            review buys judgment where it matters. Leave it following the realm unless you
            have a reason.
          </span>
        </div>
      </div>

      <!-- ── where it runs ────────────────────────────────── -->
      <div class="panel">
        <div class="panel-hd"><span class="k-label">Where this agent is used</span></div>
        <div style="padding:0">
          <div class="phase-row<%= " active" if phase_on %>">
            <span class="phase-name"><%= agent.role.capitalize %></span>
            <span class="mono-meta" style="flex:1">
              <%= phase_on ? "runs for every ticket that reaches this phase" : "phase is disabled in settings — this agent never runs" %>
            </span>
            <%= link_to phase_on ? "on" : "off", settings_path,
                        class: "tag", style: "color:#{phase_on ? 'var(--ok)' : 'var(--tx3)'};text-decoration:none" %>
          </div>
        </div>
        <div style="padding:11px 14px;display:flex;flex-direction:column;gap:7px">
          <div style="display:flex;gap:9px;align-items:baseline;flex-wrap:wrap">
            <span class="k-label" style="width:96px;flex:none">Runs</span>
            <span class="mono" style="font-size:11.5px;color:<%= invocation ? "var(--info)" : "var(--tx2)" %>">
              <%= invocation || "the built-in #{agent.role} prompt" %>
            </span>
          </div>
          <% if invocation %>
            <span class="mono-meta">
              from your harness — <%= Harness.detect(@setting)&.repo %>/.claude
            </span>
          <% end %>
          <div style="display:flex;gap:9px;align-items:baseline;flex-wrap:wrap">
            <span class="k-label" style="width:96px;flex:none">Can delegate to</span>
            <% if delegates.any? %>
              <div class="chip-row">
                <% delegates.each do |name| %><span class="tool-chip"><%= name %></span><% end %>
              </div>
            <% else %>
              <span class="mono-meta">nothing — it does the work itself</span>
            <% end %>
          </div>
          <% if agent.tools.any? %>
            <div style="display:flex;gap:9px;align-items:baseline;flex-wrap:wrap">
              <span class="k-label" style="width:96px;flex:none">Tools</span>
              <div class="chip-row">
                <% agent.tools.each do |tool| %><span class="tool-chip"><%= tool %></span><% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- ── what it has done ─────────────────────────────── -->
      <div class="panel">
        <div class="panel-hd"><span class="k-label">Record</span></div>
        <div class="agent-stats" style="padding:12px 14px">
          <% runs = PhaseRun.joins(:ticket).where(phase: agent.role, tickets: { agent_id: agent.id }) %>
          <% [["spent today", "$#{format('%.2f', agent.cost_today)}"],
              ["tickets", agent.tickets.count],
              ["runs", PhaseRun.where(phase: agent.role).count]].each do |key, value| %>
            <div class="agent-stat">
              <span class="k"><%= key %></span>
              <span class="v"><%= value %></span>
            </div>
          <% end %>
        </div>
        <div class="cycle-foot">Currently: <span class="val"><%= agent.doing %></span></div>
      </div>
    </div>
  </div>
</div>
