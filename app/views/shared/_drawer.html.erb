<% ticket = @drawer_ticket %>
<% meta = state_meta(ticket.state) %>
<div class="overlay">
  <%= link_to "", request.path, class: "overlay-dismiss" %>
  <div class="drawer">
    <div class="drawer-hd">
      <div class="drawer-hd-row">
        <span class="drawer-id"><%= ticket.code %></span>
        <span class="tag" style="color:<%= meta[:tone] %>"><%= meta[:name] %></span>
        <% if ticket.risky? %><span class="risk-tag">RISK</span><% end %>
        <span class="spacer"></span>
        <%= link_to "✕", request.path, class: "close-btn" %>
      </div>
      <div class="drawer-title"><%= ticket.title %></div>
      <% if (blocker = ticket.blocker) %>
        <div class="mono-meta" style="color:var(--warn)">⛔ blocked · <%= blocker[:type] %> — <%= blocker[:label] %></div>
      <% end %>
      <div class="drawer-meta">
        <span><%= ticket.repo %></span>
        <span><%= ticket.agent_label %></span>
        <span><%= ticket.est_label %></span>
        <span>$<%= format("%.2f", ticket.cost) %><%= " · #{ticket.tokens_label}" if ticket.tokens_label %></span>
        <% if (change = PhasePrompts.change_ref(ticket)) %>
          <span style="color:var(--info)">⎇ <%= change %></span>
        <% end %>
        <% if @setting.live_mode? %>
          <%= link_to "💬 discuss", activity_path(room: ticket.code), style: "color:var(--info)" %>
        <% end %>
      </div>
    </div>

    <div class="drawer-body">
      <% if (gate = ticket.ticket_gates.detect { |g| g.status == "pending" }) %>
        <div class="gate-banner" style="border:1px solid var(--warn);border-radius:5px">
          <span class="gate-word">SUMMONS</span>
          <span class="gate-text"><%= gate.reason %></span>
          <%= button_to "Approve", approve_gate_path(gate), form_class: "bt",
                        class: "btn-outline-warn busy-btn", data: { turbo_submits_with: "Approving…" } %>
        </div>
      <% end %>

      <!-- ── overview ─────────────────────────────────────── -->
      <% enriching = @setting.setup["enrich:#{ticket.code}"].to_i > 5.minutes.ago.to_i %>
      <% has_overview = ticket.description.present? || ticket.technical_notes.present? || ticket.acceptance_criteria.any? %>
      <div class="panel">
        <div class="panel-hd">
          <span class="k-label">Overview</span>
          <span class="spacer"></span>
          <% if enriching %>
            <span class="mono-meta" style="color:var(--accent)" data-controller="live-refresh">
              <span class="dot" style="background:var(--accent);animation:pulse 1.8s infinite"></span> enriching…
            </span>
          <% elsif @setting.live_mode? && Workspace.repo_path(ticket.repo).present? %>
            <%= button_to has_overview ? "↻ re-enrich" : "✦ enrich", ticket_enrich_path(ticket.code),
                          form_class: "bt", class: "chip hv-acc busy-btn",
                          style: "padding:1px 8px;font-size:10px",
                          data: { turbo_submits_with: "starting…" } %>
          <% end %>
        </div>
        <div style="padding:12px 14px;display:flex;flex-direction:column;gap:11px">
          <% if ticket.description.present? %>
            <div style="font-size:12.5px;color:var(--tx);line-height:1.6;white-space:pre-wrap"><%= ticket.description %></div>
          <% end %>
          <% if ticket.technical_notes.present? %>
            <div style="display:flex;flex-direction:column;gap:4px">
              <span class="k-label" style="font-size:9.5px">Technical notes</span>
              <div style="font-size:12px;color:var(--tx2);line-height:1.6;white-space:pre-wrap"><%= ticket.technical_notes %></div>
            </div>
          <% end %>
          <% if ticket.acceptance_criteria.any? %>
            <div style="display:flex;flex-direction:column;gap:5px">
              <span class="k-label" style="font-size:9.5px">Acceptance criteria</span>
              <% ticket.acceptance_criteria.each do |criterion| %>
                <div style="display:flex;gap:8px;font-size:12px;color:var(--tx2);line-height:1.5">
                  <span style="color:<%= ticket.done? ? 'var(--ok)' : 'var(--tx3)' %>;flex:none"><%= ticket.done? ? "✓" : "◇" %></span>
                  <span style="overflow-wrap:anywhere"><%= criterion %></span>
                </div>
              <% end %>
            </div>
          <% end %>
          <% unless has_overview %>
            <span class="mono-meta">no brief yet — grooming fills this in<%= ", or click enrich" if @setting.live_mode? %></span>
          <% end %>
        </div>
      </div>

      <!-- ── phases with per-run logs ─────────────────────── -->
      <div class="phase-list">
        <span class="k-label">Phases</span>
        <% runs_by_phase = ticket.phase_runs.group_by(&:phase) %>
        <% done_runs = ticket.phase_runs.select { |r| r.status == "done" }.index_by(&:phase) %>
        <% Ticket::PHASES.each do |phase| %>
          <% done = done_runs[phase] %>
          <% active = ticket.state == phase %>
          <% active_run = active ? ticket.current_phase_run : nil %>
          <% failed = active_run&.status == "failed" %>
          <% live = active_run&.runner == "claude" %>
          <% tone = if done then "var(--ok)"
                    elsif failed then "var(--err)"
                    elsif active then (@setting.running? || live) ? "var(--accent)" : "var(--warn)"
                    else "var(--tx3)" end %>
          <div class="phase-row<%= ' active' if active %>">
            <span class="dot" style="background:<%= tone %>"></span>
            <span class="phase-name"><%= phase.capitalize %></span>
            <span class="phase-note"><%= active_run&.note || done&.note || (active ? DemoScript.note_for(phase) : "not started") %></span>
            <span class="phase-dur"><%= done ? short_duration(done.duration_s.to_i) : failed ? "failed" : active ? (live ? "live" : "running") : "—" %></span>
            <% if failed %>
              <%= button_to "retry", ticket_phase_path(ticket.code, op: "retry"),
                            form_class: "bt", class: "phase-btn", style: "border-color:var(--err);color:var(--err)" %>
            <% elsif active && live %>
              <span class="phase-btn acc" style="cursor:default">claude</span>
            <% elsif active %>
              <%= button_to @setting.running? ? "pause" : "resume",
                            ticket_phase_path(ticket.code, op: @setting.running? ? "pause" : "resume"),
                            form_class: "bt", class: "phase-btn acc" %>
            <% else %>
              <span class="phase-btn" style="cursor:default"><%= done ? "done" : "queued" %></span>
            <% end %>
          </div>
          <% run_with_log = (runs_by_phase[phase] || []).select { |r| r.log.present? }.max_by { |r| r.started_at || Time.at(0) } %>
          <% if run_with_log %>
            <details class="phase-log">
              <summary class="mono-meta" style="cursor:pointer;padding:2px 0 2px 20px">
                view <%= phase %> log<%= " · exit #{run_with_log.exit_status}" if run_with_log.exit_status %><%= " · $#{format('%.2f', run_with_log.cost)}" if run_with_log.cost.to_f.positive? %>
              </summary>
              <pre class="mono" style="font-size:10.5px;line-height:1.6;color:var(--tx2);white-space:pre-wrap;word-break:break-all;max-height:200px;overflow:auto;margin:6px 0 4px;background:var(--sunken);border-radius:4px;padding:8px 10px"><%= run_with_log.log.last(4000) %></pre>
            </details>
          <% end %>
        <% end %>
      </div>

      <!-- ── diff + review actions ────────────────────────── -->
      <div class="panel">
        <div class="panel-hd" style="padding:10px 13px">
          <span class="k-label">Diff · review</span>
          <span class="spacer"></span>
          <% adds = ticket.diff.count { |d| d["line"].to_s.start_with?("+") } %>
          <% dels = ticket.diff.count { |d| d["line"].to_s.start_with?("-") } %>
          <span class="mono-meta" style="color:var(--ok)">+<%= adds %></span>
          <span class="mono-meta" style="color:var(--err)">−<%= dels %></span>
        </div>
        <% if ticket.diff.any? %>
          <div class="diff-body">
            <% ticket.diff.each do |d| %>
              <div class="diff-line" style="background:<%= d["bg"] %>;color:<%= d["fg"] %>"><%= d["line"] %></div>
            <% end %>
          </div>
        <% else %>
          <div class="diff-body" style="padding:12px 13px">
            <span class="mono-meta">no diff yet — it appears when implementation finishes</span>
          </div>
        <% end %>
        <%# review actions unlock only once implementation is complete %>
        <% reviewable = %w[review testing deployment done].include?(ticket.state) %>
        <% actionable = reviewable && Workspace.repo_path(ticket.repo).present? %>
        <% if actionable %>
          <div class="diff-foot" style="flex-direction:column;align-items:stretch;gap:9px">
            <span class="k-label" style="font-size:9.5px">Review actions</span>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <%= button_to "✓ Approve & merge", ticket_merge_path(ticket.code), form_class: "bt",
                            class: "btn-outline-ok busy-btn",
                            data: { turbo_submits_with: "Merging…",
                                    turbo_confirm: "Merge pipe/#{ticket.code.downcase} into the base branch#{ticket.done? ? '' : ' and complete this ticket'}?" } %>
            </div>
            <%= form_with url: ticket_request_changes_path(ticket.code), method: :post,
                          style: "display:flex;gap:8px" do %>
              <input name="feedback" autocomplete="off" class="textarea"
                     placeholder="Request changes — what should be different?"
                     style="flex:1;min-height:0;padding:6px 10px;font-size:11.5px">
              <button type="submit" class="btn-ghost btn-sm hv-err busy-btn"
                      data-turbo-submits-with="Sending…">Request changes</button>
            <% end %>
          </div>
        <% elsif ticket.state == "implementation" %>
          <div class="diff-foot">
            <span class="mono-meta">implementation in progress — review actions unlock when it completes</span>
          </div>
        <% elsif reviewable %>
          <div class="diff-foot">
            <span class="btn-outline-ok" style="cursor:default;opacity:.5" title="demo ticket — no workspace repo">Approve &amp; merge</span>
            <span class="btn-ghost btn-sm" style="cursor:default;opacity:.5">Request changes</span>
          </div>
        <% end %>
      </div>

      <!-- ── ticket activity ──────────────────────────────── -->
      <% ticket_events = Event.where(ticket_code: ticket.code).recent.limit(20).to_a %>
      <% if ticket_events.any? %>
        <details class="panel" <%= "open".html_safe if ticket_events.size <= 6 %>>
          <summary class="panel-hd" style="cursor:pointer">
            <span class="k-label">Activity</span>
            <span class="spacer"></span>
            <span class="mono-meta"><%= ticket_events.size %> events</span>
          </summary>
          <div class="rfc-log" style="max-height:200px">
            <% ticket_events.each do |event| %>
              <div class="rfc-log-row">
                <span class="mono-meta" style="flex:none;font-variant-numeric:tabular-nums"><%= event_time(event) %></span>
                <span class="stream-phase" style="flex:none;color:<%= event.tone %>"><%= event.phase_tag %></span>
                <span style="flex:1;min-width:0;overflow-wrap:anywhere"><%= event.text %></span>
              </div>
            <% end %>
          </div>
        </details>
      <% end %>

      <div class="drawer-grid">
        <div class="drawer-mini">
          <span class="k-label">Depends on</span>
          <% deps = Ticket.where(code: ticket.dep_codes).index_by(&:code) %>
          <% if ticket.dep_codes.empty? %><span class="mono-meta">no dependencies</span><% end %>
          <% ticket.dep_codes.each do |code| %>
            <% dep = deps[code] %>
            <div class="dep-row">
              <span class="dep-id" style="color:<%= dep ? state_meta(dep.state)[:tone] : 'var(--tx3)' %>"><%= code %></span>
              <span class="dep-title"><%= dep&.title || "—" %></span>
            </div>
          <% end %>
        </div>
        <div class="drawer-mini">
          <span class="k-label">Artifacts</span>
          <% if ticket.artifacts.empty? %><span class="mono-meta">none yet</span><% end %>
          <% ticket.artifacts.each do |artifact| %>
            <div class="artifact"><%= artifact %></div>
          <% end %>
        </div>
      </div>

      <!-- ── manage ───────────────────────────────────────── -->
      <% if ticket.editable? || ticket.deletable? %>
        <div class="panel">
          <% if ticket.editable? %>
            <details>
              <summary class="panel-hd" style="cursor:pointer">
                <span class="k-label">✎ Edit ticket</span>
              </summary>
              <%= form_with url: ticket_path(ticket.code), method: :patch,
                            style: "padding:12px 14px;display:flex;flex-direction:column;gap:8px" do %>
                <input name="title" value="<%= ticket.title %>" class="textarea"
                       style="min-height:0;padding:6px 10px;font-size:12px">
                <textarea name="description" rows="3" class="textarea"
                          placeholder="Description — any format"
                          style="min-height:0;padding:6px 10px;font-size:11.5px"><%= ticket.description %></textarea>
                <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                  <select name="repo" class="textarea" style="min-height:0;padding:5px;font-size:11.5px;width:160px">
                    <% ([ticket.repo] + Workspace.selected_ticket_targets).compact.uniq.each do |repo| %>
                      <option value="<%= repo %>" <%= "selected" if repo == ticket.repo %>><%= repo %></option>
                    <% end %>
                  </select>
                  <input name="est_label" value="<%= ticket.est_label %>" class="textarea"
                         style="min-height:0;padding:5px 8px;font-size:11.5px;width:70px" title="estimate">
                  <input type="hidden" name="risky" value="0">
                  <label style="display:flex;gap:5px;align-items:center;font-size:11px;color:var(--tx2)">
                    <input type="checkbox" name="risky" value="1" <%= "checked" if ticket.risky? %>>risky
                  </label>
                </div>
                <input name="dep_codes" value="<%= ticket.dep_codes.join(', ') %>" class="textarea"
                       placeholder="Depends on — ticket codes, comma-separated"
                       style="min-height:0;padding:6px 10px;font-size:11.5px;font-family:var(--mono)">
                <div>
                  <button type="submit" class="btn-ghost btn-sm hv-acc busy-btn"
                          data-turbo-submits-with="Saving…">Save changes</button>
                </div>
              <% end %>
            </details>
          <% end %>
          <% if ticket.deletable? %>
            <div style="padding:10px 14px;<%= 'border-top:1px solid var(--soft);' if ticket.editable? %>display:flex;align-items:center;gap:10px">
              <span class="mono-meta">remove this ticket and its history</span>
              <span class="spacer"></span>
              <%= button_to "Delete ticket", ticket_path(ticket.code), method: :delete, form_class: "bt",
                            class: "btn-ghost btn-sm hv-err busy-btn",
                            data: { turbo_confirm: "Delete #{ticket.code} permanently? This cannot be undone.",
                                    turbo_submits_with: "Deleting…" } %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
