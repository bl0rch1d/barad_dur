<div class="titlebar">
  <div class="tl-dots"><span class="d-red"></span><span class="d-yellow"></span><span class="d-green"></span></div>
  <div class="brand">
    <svg class="brand-seal" width="26" height="26" viewBox="0 0 150 150">
      <circle cx="75" cy="75" r="68" fill="none" style="stroke:var(--seal-mid)" stroke-width="6"></circle>
      <g transform="translate(24 9) scale(0.85)">
        <path fill-rule="evenodd" d="M43 26 C51 14 69 14 77 26 C69 38 51 38 43 26 Z M60 17 C57.5 22 57.5 30 60 35 C62.5 30 62.5 22 60 17 Z" style="fill:var(--seal-mid)"></path>
        <path d="M54 52 L44 16 L50 13 L57 46 Z M66 52 L76 16 L70 13 L63 46 Z M54 52 H66 L69 72 H51 Z M49 76 H71 L75 98 H45 Z M42 102 H78 L83 126 H37 Z M33 130 H87 L90 142 H30 Z" style="fill:var(--seal-mid)"></path>
      </g>
    </svg>
    <span class="brand-name">BARAD-DÛR</span>
    <span class="mono-dim" style="font-style:italic;color:var(--seal-mid);opacity:.85">the Eye is open · the watch holds</span>
    <% if Workspace.repos.any? %>
      <span class="mono-dim"><%= Workspace.root.basename %> · openspec · <%= Workspace.repos.size %> <%= "repo".pluralize(Workspace.repos.size) %></span>
    <% else %>
      <span class="mono-dim">no realm bound</span>
    <% end %>
  </div>

  <div class="spacer"></div>

  <div class="seg">
    <% [["auto", "Unleashed", "Runs every phase; stops only on blocks"],
        ["risky", "Wary", "Approve money, migrations, deploys"],
        ["every", "Chained", "Approve every phase transition"]].each do |value, label, hint| %>
      <%= button_to label, settings_autonomy_path(value: value), form_class: "bt", title: hint,
                    class: "seg-btn#{' on' if @setting.autonomy == value}" %>
    <% end %>
  </div>

  <div class="seg" data-controller="theme">
    <% %w[dark light].each do |theme| %>
      <button type="button" class="seg-btn mono<%= ' on' if current_theme == theme %>"
              data-action="theme#set" data-theme-theme-param="<%= theme %>"><%= theme %></button>
    <% end %>
  </div>

  <div class="vdiv"></div>

  <div class="run-group">
    <span class="run-label">
      <span class="dot" style="background:<%= @setting.running? ? 'var(--accent)' : 'var(--warn)' %>;<%= 'animation:pulse 1.8s infinite' if @setting.running? %>"></span>
      <%= @setting.running? ? "the watch holds" : "quenched" %>
    </span>
    <%= button_to settings_toggle_run_path, form_class: "bt", class: "btn-accent" do %>
      <span class="run-glyph"><%= @setting.running? ? "❙❙" : "▶" %></span><%= @setting.running? ? "Quench" : "Kindle" %>
    <% end %>
    <%= button_to "Stop", settings_stop_path, form_class: "bt", class: "btn-ghost hv-err" %>
  </div>
</div>
