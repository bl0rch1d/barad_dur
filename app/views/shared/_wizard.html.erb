<% step = @wizard_step %>
<% setup = @setting.setup %>
<% copy = [
  ["Choose the workspace", "Point at a single project or a folder of repos. The pipeline only touches what you check here — everything else is read-only context."],
  ["Authentication", "Use your subscription or a raw API key. Keys never leave the machine; they are injected per agent process."],
  ["Development framework", "This decides what a phase actually runs. A harness in your workspace is auto-detected and mapped."],
  ["Parsing the workspace", "Indexing code and specs to build the dashboard. Anything ambiguous becomes a question rather than a guess."],
  ["Ready — pick your leash", "Autonomy is a feature flag, not a one-way door. Switch it from the titlebar mid-run; in-flight phases finish, the next one respects the new setting."]
][step - 1] %>
<% ws_repos = Workspace.repos %>
<% ws_selected = ws_repos.select { |r| wizard_setup("repo:#{r[:name]}", "true") == "true" } %>
<% repos_selected = ws_selected.size %>

<div class="overlay-center">
  <div class="wizard">
    <div class="wizard-hd">
      <span class="screen-title">Setup</span>
      <span class="mono-dim">step <%= step %> of 5</span>
      <span class="spacer"></span>
      <%= link_to "✕", request.path, class: "close-btn" %>
    </div>

    <div class="wsteps">
      <% %w[Folder Auth Framework Parse Autonomy].each_with_index do |label, i| %>
        <div class="wstep<%= ' reached' if step >= i + 1 %><%= ' current' if step == i + 1 %>">
          <span class="bar"></span>
          <span class="lbl"><%= label %></span>
        </div>
      <% end %>
    </div>

    <div class="wizard-body">
      <div class="wizard-intro">
        <span class="wizard-title"><%= copy[0] %></span>
        <span class="wizard-blurb"><%= copy[1] %></span>
      </div>

      <% if step == 1 %>
        <div class="wizard-stack">
          <% ws_mounted = Workspace.mount_root.directory? %>
          <% ws_layout = ws_mounted ? Workspace.layout : :empty %>
          <div class="path-row">
            <span class="path"><%= ws_mounted ? Workspace.root : "no workspace mounted" %></span>
            <% if (host_path = ENV["WORKSPACE_PATH"].presence) %>
              <span class="mono-meta">mounted from <%= host_path %></span>
            <% end %>
            <% if ws_mounted %>
              <span class="tag" style="color:<%= ws_layout == :empty ? 'var(--warn)' : 'var(--info)' %>">
                <%= { monorepo: "monorepo", multi_repo: "#{ws_repos.size} repos", empty: "no repos here" }[ws_layout] %>
              </span>
            <% end %>
          </div>
          <% if ws_mounted %>
            <% ws_browse = Workspace.browse %>
            <% ws_parent = Workspace.parent_rel %>
            <% if ws_parent || ws_browse.any? %>
              <div class="k-label" style="letter-spacing:.1em">Choose a folder — a monorepo or a folder of repositories</div>
              <div style="display:flex;flex-direction:column;gap:4px">
                <% unless ws_parent.nil? %>
                  <%= button_to wizard_patch_path(key: "workspace_dir", value: ws_parent, wizard: step),
                                form_class: "bt", class: "check-row hv-acc" do %>
                    <span class="mono" style="width:15px;color:var(--tx3)">↑</span>
                    <span class="check-name" style="width:auto;flex:none">..</span>
                    <span class="check-meta">up one level</span>
                  <% end %>
                <% end %>
                <% ws_browse.each do |entry| %>
                  <%= button_to wizard_patch_path(key: "workspace_dir", value: entry[:rel], wizard: step),
                                form_class: "bt", class: "check-row hv-acc" do %>
                    <span class="mono" style="width:15px;color:<%= entry[:kind] == :git_repo ? 'var(--info)' : 'var(--tx3)' %>"><%= entry[:kind] == :git_repo ? "◆" : "▸" %></span>
                    <span class="check-name" style="width:auto;flex:none"><%= entry[:name] %></span>
                    <span class="check-meta">
                      <%= case entry[:kind]
                          when :git_repo    then "git repository — select as monorepo"
                          when :repo_folder then "#{entry[:repo_count]} repos inside — select as multi-repo"
                          else "folder — open" end %>
                    </span>
                  <% end %>
                <% end %>
              </div>
            <% end %>
            <% if ws_repos.any? %>
              <div class="k-label" style="letter-spacing:.1em">
                <%= ws_layout == :monorepo ? "Monorepo detected — the pipeline owns this repository" : "Detected #{ws_repos.size} repos — pick what the pipeline owns" %>
              </div>
              <% ws_repos.each do |repo| %>
                <% on = wizard_setup("repo:#{repo[:name]}", "true") == "true" %>
                <% subs = Workspace.subprojects(repo) %>
                <%= button_to wizard_patch_path(key: "repo:#{repo[:name]}", value: (!on).to_s, wizard: step),
                              form_class: "bt", class: "check-row#{' on' if on}" do %>
                  <span class="checkbox"><%= "✓" if on %></span>
                  <span class="check-name"><%= repo[:name] %></span>
                  <span class="check-meta"><%= repo[:branch] %> · <%= repo[:commits] %> commits<%= " · #{subs.size} sub-projects" if subs.any? %></span>
                  <span class="mono-meta"><%= repo[:files] %> files</span>
                <% end %>
              <% end %>
            <% elsif ws_browse.empty? && ws_parent.nil? %>
              <div class="parse-card" style="border-color:var(--warn);gap:9px">
                <span class="k-label" style="color:var(--warn)">Nothing mounted here yet</span>
                <div class="mono-meta" style="line-height:1.6;color:var(--tx2)">
                  The tower can only see the folder mounted at <span class="mono">/workspace</span>, and it is
                  empty<%= " (from #{ENV["WORKSPACE_PATH"]})" if ENV["WORKSPACE_PATH"].present? %>.
                  Point it at your code, then restart:
                </div>
                <div class="diff-body" style="border-radius:5px">
                  <div class="diff-line" style="color:var(--tx2)"># 1. edit .env in the project root</div>
                  <div class="diff-line" style="color:var(--accent)">WORKSPACE_PATH=~/dev</div>
                  <div class="diff-line" style="color:var(--tx3)">#    a folder of repositories, or one repository</div>
                  <div class="diff-line" style="color:var(--tx2)"># 2. restart</div>
                  <div class="diff-line" style="color:var(--accent)">docker compose up -d</div>
                </div>
                <span class="mono-meta">Or drop the repositories straight into the <span class="mono">workspace/</span> folder of this project.</span>
              </div>
            <% end %>
          <% else %>
            <span class="mono-meta">no workspace mounted — start the stack with WORKSPACE_PATH pointing at your code</span>
          <% end %>
        </div>
      <% end %>

      <% if step == 2 %>
        <div class="wizard-stack">
          <% sub_ok = ClaudeCodeRunner.subscription_credentials? %>
          <% key_ok = ClaudeCodeRunner.api_key? %>
          <% [["Claude subscription", "Uses your Claude Pro/Max login — the host's ~/.claude is mounted into the pipeline containers (or set CLAUDE_CODE_OAUTH_TOKEN). No per-token billing.",
               sub_ok ? "✓ detected" : "not found", sub_ok],
              ["API key", "Per-token billing via ANTHROPIC_API_KEY with the daily spend cap. Best when several agents run in parallel.",
               key_ok ? "✓ key set" : "metered", key_ok]].each_with_index do |(label, blurb, tag, ok), i| %>
            <% on = wizard_setup("auth", "0") == i.to_s %>
            <%= button_to wizard_patch_path(key: "auth", value: i, wizard: step), form_class: "bt",
                          class: "radio-card#{' on' if on}" do %>
              <span class="radio-dot"></span>
              <div class="radio-body">
                <span class="radio-label"><%= label %><%= " · default" if i.zero? %></span>
                <span class="radio-blurb"><%= blurb %></span>
              </div>
              <span class="mono-meta" style="<%= 'color:var(--ok)' if ok %>"><%= tag %></span>
            <% end %>
          <% end %>
          <div class="key-box">
            <span class="k-label"><%= @setting.subscription_auth? ? "Subscription credentials" : "API key" %></span>
            <% status = ClaudeCodeRunner.auth_status(@setting) %>
            <input class="key-input" readonly
                   value="<%= @setting.subscription_auth? ? "auth: claude subscription (mounted login)" : (key_ok ? "sk-ant-•••••••••••••••••••••#{ENV['ANTHROPIC_API_KEY'].to_s.last(4)}" : "no ANTHROPIC_API_KEY in environment") %>">
            <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
              <span class="mono-meta" style="<%= 'color:var(--ok)' if status[:ok] %>"><%= status[:label] %></span>
            </div>
          </div>
          <div class="cap-row">
            <span style="font-size:12.5px;flex:1">Orchestrator model</span>
            <div class="chip-row">
              <% Setting::ORCHESTRATOR_MODELS.each do |value, label| %>
                <%= button_to "#{label}#{' · default' if value == Setting::DEFAULT_ORCHESTRATOR_MODEL}",
                              wizard_patch_path(key: "orchestrator_model", value: value, wizard: step),
                              form_class: "bt",
                              class: "chip#{' on' if @setting.orchestrator_model == value}" %>
              <% end %>
            </div>
          </div>
          <div class="cap-row">
            <span style="font-size:12.5px;flex:1">Agent runner</span>
            <% if AgentRunner.live_available? %>
              <span class="mono-meta" style="color:var(--ok)">✓ claude code CLI ready — phases run for real in the workspace</span>
            <% else %>
              <span class="mono-meta" style="color:var(--warn)">unavailable — claude CLI or auth missing; nothing will execute until fixed</span>
            <% end %>
          </div>
          <div class="cap-row">
            <span style="font-size:12.5px;flex:1">Daily spend cap</span>
            <span class="mono" style="font-size:13px;font-weight:600">$<%= @setting.spend_cap.to_i %></span>
            <span class="mono-meta">pipeline pauses at cap</span>
          </div>
        </div>
      <% end %>

      <% if step == 3 %>
        <% fw = wizard_setup("fw", "0") %>
        <div class="wizard-stack">
          <% [["openspec", "Specs are the contract: each phase reads and writes openspec files, so plans and code stay attached to requirements.", "recommended", "var(--ok)"],
              ["Custom agentic harness", "Your repo's own .claude commands, skills and agents drive the phases; the app reads their artifacts back into the board.", "auto-detected", "var(--info)"],
              ["Vanilla — built-in prompts", "No framework. Every phase runs the app's built-in spec-first prompts, each producing a written artifact you can review.", "fallback", "var(--tx3)"]].each_with_index do |(label, blurb, tag, tag_tone), i| %>
            <% on = fw == i.to_s %>
            <%= button_to wizard_patch_path(key: "fw", value: i, wizard: step), form_class: "bt",
                          class: "radio-card#{' on' if on}" do %>
              <span class="radio-dot"></span>
              <div class="radio-body">
                <span class="radio-label"><%= label %></span>
                <span class="radio-blurb"><%= blurb %></span>
              </div>
              <span class="tag" style="color:<%= tag_tone %>"><%= tag %></span>
            <% end %>
          <% end %>

          <% detected_harness = Harness.detect %>
          <% if fw != "2" %>
            <% harness_choices = Harness.available %>
            <% chosen_dir = wizard_setup("harness_dir", "") %>
            <% if harness_choices.size > 1 || chosen_dir.present? %>
              <div class="panel" style="border-color:var(--info)">
                <div class="panel-hd">
                  <span class="k-label" style="color:var(--info)">Which harness drives the phases</span>
                  <span class="spacer"></span>
                  <span class="mono-meta"><%= harness_choices.size %> found in the workspace</span>
                </div>
                <div style="padding:11px 13px;display:flex;flex-direction:column;gap:7px">
                  <div class="chip-row">
                    <%= button_to wizard_patch_path(key: "harness_dir", value: "", wizard: step),
                                  form_class: "bt", class: "chip#{' on' if chosen_dir.blank?}" do %>
                      auto<%= " · #{detected_harness.repo}" if chosen_dir.blank? && detected_harness %>
                    <% end %>
                    <% harness_choices.each do |choice| %>
                      <%= button_to wizard_patch_path(key: "harness_dir", value: choice[:rel], wizard: step),
                                    form_class: "bt", class: "chip#{' on' if chosen_dir == choice[:rel]}" do %>
                        <%= choice[:rel] == "." ? "#{choice[:name]} (workspace root)" : choice[:rel] %>
                      <% end %>
                    <% end %>
                  </div>
                  <% if (picked = harness_choices.detect { |c| c[:rel] == chosen_dir }) %>
                    <span class="mono-meta">
                      <%= picked[:commands] %> commands · <%= picked[:skills] %> skills · <%= picked[:agents] %> agents
                      <%= "· outside the repos you selected — chosen deliberately, so it is used anyway" unless picked[:selected] %>
                    </span>
                  <% elsif chosen_dir.present? %>
                    <span class="mono-meta" style="color:var(--warn)">
                      <%= chosen_dir %> has no .claude commands or skills — falling back to auto-detection
                    </span>
                  <% else %>
                    <span class="mono-meta">auto picks the first selected repo that carries one; pick a directory to override</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>

          <% if detected_harness && fw != "2" %>
            <div class="panel harness-panel">
              <div class="panel-hd">
                <span class="k-label" style="color:var(--info)">Harness in use · <%= detected_harness.repo %></span>
                <span class="spacer"></span>
                <span class="mono-meta"><%= detected_harness.commands.size %> commands · <%= detected_harness.skills.size %> skills · <%= detected_harness.agents.size %> agents</span>
              </div>
              <div style="padding:12px 13px;display:flex;flex-direction:column;gap:7px">
                <div class="k-label" style="letter-spacing:.08em;padding-bottom:2px">Phase → command · click a row to switch source</div>
                <% Ticket::PHASES.each do |phase| %>
                  <% default_inv = Harness.default_invocation(phase) %>
                  <% active_inv = Harness.phase_invocation(phase) %>
                  <% overridden = wizard_setup("map:#{phase}", "") == "built-in" %>
                  <% if default_inv %>
                    <%= button_to wizard_patch_path(key: "map:#{phase}", value: overridden ? "harness" : "built-in", wizard: step),
                                  form_class: "bt", class: "map-row#{' on' if active_inv}" do %>
                      <span class="dot" style="background:<%= active_inv ? 'var(--info)' : 'var(--tx3)' %>"></span>
                      <span class="map-phase"><%= phase.capitalize %></span>
                      <span class="mono-meta" style="flex:none">→</span>
                      <span class="map-cmd" style="color:<%= active_inv ? 'var(--info)' : 'var(--tx3)' %>"><%= active_inv || "built-in: default prompt" %></span>
                      <span class="tag" style="color:<%= active_inv ? 'var(--info)' : 'var(--tx3)' %>"><%= active_inv ? "harness" : "built-in" %></span>
                    <% end %>
                  <% else %>
                    <div class="map-row" style="cursor:default">
                      <span class="dot" style="background:var(--tx3)"></span>
                      <span class="map-phase"><%= phase.capitalize %></span>
                      <span class="mono-meta" style="flex:none">→</span>
                      <span class="map-cmd" style="color:var(--tx3)">built-in prompt (no harness match)</span>
                      <span class="tag" style="color:var(--tx3)">built-in</span>
                    </div>
                  <% end %>
                <% end %>
                <% if detected_harness.agents.any? %>
                  <div style="padding-top:9px;border-top:1px solid var(--soft);margin-top:3px;display:flex;flex-direction:column;gap:5px">
                    <span class="k-label" style="letter-spacing:.08em">Project agents — mapped onto the roster, offered to phases for delegation</span>
                    <span class="mono-meta"><%= detected_harness.agents.first(10).join(" · ") %><%= " · +#{detected_harness.agents.size - 10} more" if detected_harness.agents.size > 10 %></span>
                  </div>
                <% end %>
                <% if detected_harness.skills.any? %>
                  <span class="mono-meta">skills: <%= detected_harness.skills.first(10).join(" · ") %></span>
                <% end %>
              </div>
            </div>
          <% elsif fw != "2" %>
            <div class="parse-card">
              <span class="mono-meta">no .claude/commands found in the workspace — phases will use the built-in prompts</span>
            </div>
          <% end %>

          <% if fw == "2" %>
            <div class="panel">
              <div class="panel-hd"><span class="k-label">Built-in spec-first loop · what each phase runs</span></div>
              <% [["Investigation", "explore", "read-only: call sites, history, clarifying questions"],
                  ["Planning", "plan", "summary, technical notes, acceptance criteria, dependencies"],
                  ["Implementation", "apply", "one pipe/* branch per ticket, real commits"],
                  ["Review", "critique", "diff review against the plan, fixes committed"],
                  ["Testing", "verify", "repo's own test command, failures fixed"],
                  ["Deployment", "ship", "changelog entry; merge stays in your hands"]].each do |phase, step_name, out| %>
                <div class="vanilla-row">
                  <span class="vanilla-phase"><%= phase %></span>
                  <span class="vanilla-step"><%= step_name %></span>
                  <span class="vanilla-out"><%= out %></span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if step == 4 %>
        <div class="wizard-stack">
          <% if ws_repos.any? %>
            <% openspec_names = Workspace.openspec_repos %>
            <% unchecked_spec_repos = openspec_names - Workspace.selected_repos(@setting).map { |r| r[:name] } %>
            <% spec_count = Capability.count %>
            <div class="parse-card" style="border-color:var(--info)">
              <span class="k-label" style="color:var(--info)">Workspace</span>
              <div class="parse-log">
                <div class="row"><span style="color:var(--ok)">✓</span><span class="t"><%= repos_selected < ws_repos.size ? "#{repos_selected} of #{ws_repos.size}" : ws_repos.size %> <%= "repo".pluralize(ws_repos.size) %> selected at <%= Workspace.root %></span></div>
                <% if openspec_names.any? %>
                  <div class="row"><span style="color:var(--ok)">✓</span><span class="t">openspec found in: <%= openspec_names.join(", ") %></span></div>
                <% else %>
                  <div class="row"><span style="color:var(--tx3)">◦</span><span class="t">no openspec/specs directories — expected &lt;repo&gt;/openspec/specs/&lt;capability&gt;/spec.md</span></div>
                <% end %>
                <% if unchecked_spec_repos.any? %>
                  <div class="row"><span style="color:var(--warn)">!</span><span class="t" style="color:var(--warn)"><%= unchecked_spec_repos.join(", ") %> contains openspec specs but is unchecked in the Folder step</span></div>
                <% end %>
                <div class="row">
                  <span style="color:<%= spec_count.positive? ? 'var(--ok)' : 'var(--tx3)' %>"><%= spec_count.positive? ? "✓" : "◦" %></span>
                  <span class="t"><%= spec_count.positive? ? "#{spec_count} capabilities · #{SpecRequirement.count} requirements in the spec index" : "spec index is empty — parse below" %></span>
                </div>
                <div class="row"><span style="color:<%= AgentRunner.live_available? ? 'var(--ok)' : 'var(--warn)' %>"><%= AgentRunner.live_available? ? "✓" : "!" %></span><span class="t">claude code runner <%= AgentRunner.live_available? ? "ready" : "unavailable — check the Auth step" %></span></div>
              </div>
              <% sync_progress = setup["spec_sync_progress"] %>
              <% sync_progress = nil if sync_progress && sync_progress["at"].to_i < 90.seconds.ago.to_i %>
              <% if sync_progress %>
                <% total = sync_progress["total"].to_i %>
                <% done = sync_progress["done"].to_i %>
                <% pct = total.positive? ? (100 * done / total) : 4 %>
                <div style="display:flex;flex-direction:column;gap:6px" data-controller="live-refresh">
                  <div style="display:flex;align-items:baseline;gap:10px">
                    <span class="mono-meta" style="color:var(--accent);flex:1">parsing <%= sync_progress["label"] %></span>
                    <span class="mono-dim"><%= total.positive? ? "#{done}/#{total} spec files" : "…" %></span>
                  </div>
                  <div class="meter"><span style="width:<%= pct %>%;background:var(--accent);transition:width .4s ease"></span></div>
                </div>
              <% else %>
                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                  <%= button_to "Parse workspace specs now", specs_sync_path(wizard: step),
                                form_class: "bt", class: "btn-ghost btn-sm hv-acc busy-btn",
                                data: { turbo_submits_with: "Starting parse…" } %>
                  <% if (last = setup["last_spec_sync"]).present? %>
                    <span class="mono-meta" style="color:<%= last.start_with?('nothing', 'parse failed') ? 'var(--warn)' : 'var(--ok)' %>">last parse: <%= last %></span>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="parse-card">
              <span class="mono-meta">no repos in the workspace — go back to the Folder step and bind a realm first</span>
            </div>
          <% end %>

          <%# While a parse is actually running this card shows its real
              progress and stays incomplete — the eased animation below is for
              the workspace scan, which finishes in a moment. It is only
              turbo-permanent when idle, so live refreshes can update the real
              numbers while parsing. %>
          <% parse = setup["spec_sync_progress"] %>
          <% parse = nil if parse && parse["at"].to_i < 90.seconds.ago.to_i %>
          <% parse_total = parse["total"].to_i if parse %>
          <% parse_pct = parse && parse_total.to_i.positive? ? (100 * parse["done"].to_i / parse_total) : 0 %>
          <div class="parse-card" id="indexing-progress-card" <%= "data-turbo-permanent" if parse.nil? %>
               data-controller="progress" data-progress-cap-value="100"
               data-progress-busy-value="<%= parse.present? %>"
               data-progress-pct-value="<%= parse_pct %>"
               data-progress-done-label-value="Workspace indexed ✓">
            <div style="display:flex;align-items:center;gap:10px">
              <span class="mono" data-progress-target="title" style="font-size:11px;color:var(--accent);flex:1">
                <%= parse ? "Parsing specs — #{parse['done']} of #{parse_total}…" : "Indexing workspace…" %>
              </span>
              <span class="mono-dim" data-progress-target="label"><%= parse ? "#{parse_pct}%" : "0%" %></span>
            </div>
            <div class="meter"><span data-progress-target="bar" style="width:0%;background:var(--accent);transition:width .2s linear"></span></div>
            <div class="parse-log">
              <% index_line = ws_selected.any? ? "indexed #{ws_selected.sum { |r| r[:files] }} files · #{ws_selected.sum { |r| r[:commits] }} commits · #{repos_selected} selected #{"repo".pluralize(repos_selected)}" : "no repos selected to index yet" %>
              <% spec_line = if parse then "parsing #{parse['label']} — #{parse['done']} of #{parse_total}"
                             elsif Capability.any? then "parsed #{Capability.count} openspec capabilities, #{SpecRequirement.count} requirements"
                             else "spec index pending"
                             end %>
              <% [[index_line, 20], [spec_line, 45],
                  ["inferred test commands from the workspace", 65],
                  ["mapped agent roles onto phases", 78],
                  ["building dependency graph from imports", 88],
                  ["summarising recent commit history", 95]].each do |text, threshold| %>
                <div class="row" data-progress-target="row" data-threshold="<%= threshold %>">
                  <span data-mark style="color:var(--tx3)">◦</span><span class="t"><%= text %></span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <% if step == 5 %>
        <div class="wizard-stack">
          <div class="summary-grid">
            <% fw_label = ["openspec", "custom harness", "vanilla prompts"][wizard_setup("fw", "0").to_i] || "openspec" %>
            <% auth_label = wizard_setup("auth", "0") == "1" ? "API key" : "subscription" %>
            <% harness = Harness.detect %>
            <% [["Workspace", ws_repos.any? ? "#{Workspace.root.basename} · #{repos_selected} of #{ws_repos.size} repos" : "not bound"],
                ["Framework", harness && fw_label != "vanilla prompts" ? "#{fw_label} · #{harness.repo}" : fw_label],
                ["Auth", auth_label],
                ["Model", Setting::ORCHESTRATOR_MODELS[@setting.orchestrator_model]],
                ["Spend cap", "$#{@setting.spend_cap.to_i} / day"],
                ["Spec index", Capability.any? ? "#{Capability.count} capabilities · #{SpecRequirement.count} reqs" : "empty"]].each do |key, value| %>
              <div class="summary-card">
                <div class="k-label" style="letter-spacing:.08em"><%= key %></div>
                <div class="summary-v"><%= value %></div>
              </div>
            <% end %>
          </div>
          <div class="parse-card">
            <span class="k-label">Autonomy — changeable any time from the titlebar</span>
            <% [["auto", "Unleashed", "Runs every phase end to end. Stops only on a real block, a failing gate, or the spend cap."],
                ["risky", "Wary (risky gated)", "Pauses before anything that touches money, migrations, deploys or files marked risky."],
                ["every", "Chained (all gated)", "One approval per phase transition. Slowest, fully auditable — good for a first week."]].each do |value, label, blurb| %>
              <% on = @setting.autonomy == value %>
              <%= button_to settings_autonomy_path(value: value, wizard: step), form_class: "bt",
                            class: "radio-card#{' on' if on}", style: "padding:10px 12px" do %>
                <span class="radio-dot" style="width:13px;height:13px"></span>
                <div class="radio-body" style="gap:3px">
                  <span style="font-size:12.5px;font-weight:600"><%= label %></span>
                  <span style="font-size:11.5px;color:var(--tx2);line-height:1.5"><%= blurb %></span>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="wizard-foot">
      <%= link_to "Back", step > 1 ? url_for(wizard: step - 1) : request.path, class: "btn-ghost" %>
      <span class="spacer"></span>
      <span class="mono-meta">
        <%= ["#{repos_selected} of #{ws_repos.size} repos selected",
             AgentRunner.live_available? ? "runner ready · #{@setting.auth_mode.tr('_', ' ')}" : "auth not detected — nothing will run",
             Harness.detect ? "harness detected" : "built-in prompts",
             ws_repos.any? ? (Capability.any? ? "#{Capability.count} capabilities in the spec index" : "no specs parsed yet") : "bind a realm first",
             "the watch begins when you start"][step - 1] %>
      </span>
      <% if step < 5 %>
        <% gate_on_indexing = step == 4 %>
        <%= link_to "Continue", url_for(wizard: step + 1),
                    id: gate_on_indexing ? "wizard-continue" : nil,
                    data: gate_on_indexing ? { progress_unlock: true, turbo_permanent: true } : {},
                    class: "btn-accent#{' locked' if gate_on_indexing}", style: "padding:7px 15px" %>
      <% else %>
        <%= button_to "Start the watch", wizard_finish_path, form_class: "bt",
                      class: "btn-accent busy-btn", style: "padding:7px 15px",
                      data: { turbo_submits_with: "Kindling…" } %>
      <% end %>
    </div>
  </div>
</div>
