# Copy to .env and edit — docker compose reads it automatically.
# Every setting is optional; the defaults work for a first run.

# The folder of code the pipeline may see: one repository, or a folder of many.
WORKSPACE_PATH=./workspace

# Where your agent subscription login lives (used when auth mode is subscription).
# CLAUDE_CONFIG_PATH=~/.claude

# Pay-per-use auth instead of a subscription.
# ANTHROPIC_API_KEY=

# Kill switch: set to "off" and no agent will ever start.
# PIPELINE_RUNNER=auto

# Set to 1 for noticeably faster pages when you are not editing the app itself.
# DISABLE_RELOADING=0

# Only needed for the optional "Push & PR" button.
# GH_TOKEN=

# Override the model that orchestrates each agent run (default: wizard choice).
# CLAUDE_MODEL=

# How long an agent may work on a single stage before it is cut off.
# CLAUDE_MAX_TURNS=120
# CLAUDE_TIMEOUT=2700

# How often the pipeline checks whether there is work to pick up.
# PIPELINE_TICK_INTERVAL=3.2
