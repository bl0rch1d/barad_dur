#!/usr/bin/env bash
# Minimal Claude Code CLI stand-in for tests and offline e2e runs.
# Emits the stream-json shape the real `claude -p --output-format stream-json`
# produces: init, a couple of messages, then a result with cost/usage.
echo '{"type":"system","subtype":"init","session_id":"stub-session","model":"stub"}'
sleep 0.1
echo '{"type":"assistant","message":{"content":[{"type":"text","text":"Scanning repository for relevant code paths"}]}}'
echo '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Read","input":{"file_path":"README.md"}}]}}'
sleep 0.1
echo '{"type":"result","subtype":"success","is_error":false,"total_cost_usd":0.0421,"duration_ms":1200,"usage":{"input_tokens":900,"output_tokens":420},"result":"Root cause identified in README.md"}'
