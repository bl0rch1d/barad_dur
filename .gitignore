# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle

/log/*
!/log/.keep

/tmp/*
!/tmp/.keep
!/tmp/pids
/tmp/pids/*
!/tmp/pids/.keep

/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

/public/assets

# Rails credentials key — never commit
/config/master.key

/node_modules
.env*

# live-mode workspace mount (user repos, never committed)
/workspace/*
!/workspace/.gitkeep

# Ignore key files for decrypting credentials and more.
/config/*.key


# stray screenshots dropped into the repo root
/Screenshot*.png
